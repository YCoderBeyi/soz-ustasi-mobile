{
  "name": "sozustasi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "audit:levels": "node scripts/audit-levels.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "audit:ui": "node scripts/audit-ui-assets.mjs",
    "generate:ui-v2": "node scripts/generate-game-ui-v2.cjs",
    "process:splash-assets": "node scripts/process-splash-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "android:add": "npx cap add android",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npm run build && npx cap run android",
    "android:doctor": "node scripts/android-doctor.mjs",
    "android:install:release": "D:\\Android\\Sdk\\platform-tools\\adb.exe install -r artifacts\\SozUstasi-1.0.0-release.apk",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat --no-daemon assembleRelease",
    "android:aab:release": "npm run android:sync && cd android && gradlew.bat --no-daemon bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.34.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
